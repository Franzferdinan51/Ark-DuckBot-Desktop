<UserControl x:Class="ArkDuckBot.Views.Panels.AIChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ArkDuckBot.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400">

    <UserControl.DataContext>
        <vm:AiChatViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12" Background="{DynamicResource CardBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Brain24" FontSize="24" Margin="0,0,8,0"/>
                    <TextBlock Text="DuckBot AI" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Icon="{ui:SymbolIcon Delete24}"
                           ToolTip="Clear chat"
                           Command="{Binding ClearChatCommand}"
                           Margin="8,0,0,0"
                           Appearance="Secondary"/>

                <!-- Thinking indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="50,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"/>
                    <TextBlock Text="Thinking..." FontSize="11" Margin="6,0,0,0" Opacity="0.7"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Messages -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,4,4,4" Padding="10,8" CornerRadius="8"
                                Background="{Binding IsUser, Converter={StaticResource BoolToChatBackground}}">
                            <StackPanel>
                                <TextBlock Text="{Binding IsUser, Converter={StaticResource UserTypeToName}}"
                                           FontSize="11" Opacity="0.7" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Response Preview (for long responses) -->
        <Border Grid.Row="2" Margin="8,4"
                Visibility="{Binding CurrentResponse, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource CardBg}" Padding="8" CornerRadius="4">
            <Expander Header="Latest Response" IsExpanded="False">
                <TextBlock Text="{Binding CurrentResponse}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </Expander>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="3" Padding="12" Background="{DynamicResource CardBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            PlaceholderText="Ask DuckBot anything about ARK..."
                            Text="{Binding CurrentPrompt, UpdateSourceTrigger=PropertyChanged}"
                            x:Name="PromptInput"/>

                <ui:Button Grid.Column="1"
                           Content="Send"
                           Icon="{ui:SymbolIcon Send24}"
                           Command="{Binding SendPromptCommand}"
                           Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Margin="0,0,0,-24" VerticalAlignment="Bottom" HorizontalAlignment="Right" Padding="8,4">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource ControlBg}" Opacity="0.9"/>
            </Border.Background>
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Opacity="0.7"/>
        </Border>
    </Grid>
</UserControl>
